---
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import Header from "./components/header.astro";
import PostHog from "./components/posthog.astro";
import { siteConfig } from "./config/site";
import "./styles.css";

const title = "IDSW 2026";
const description =
  "Indonesia Software Developer Conference (IDSW). Indonesia's biggest community-led developer conference, organized by PERKODI in Jakarta.";
const keywords =
  "Indonesia Software Developer Conference, IDSW, PERKODI, developer conference, Jakarta, software engineering";
const ogAlt = "IDSW 2026. Indonesia Software Developer Conference.";

const isPublic = true;
const canonicalUrl = new URL("/", Astro.site).href;
const ogImageUrl = new URL("/og.jpg", Astro.site).href;

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: siteConfig.event.name,
  description,
  startDate: "2026-11-21",
  endDate: "2026-11-22",
  image: ogImageUrl,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: siteConfig.event.venue,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Jakarta Selatan",
      addressCountry: "ID",
    },
  },
  organizer: {
    "@type": "Organization",
    name: "PERKODI",
    url: "https://perkodi.org",
  },
  ...(siteConfig.tickets.enabled
    ? {
        offers: {
          "@type": "Offer",
          url: siteConfig.tickets.url,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {isPublic && <meta name="robots" content="index, follow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="IDSW Organizers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IDSW" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@idswdev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />

    <title>{title}</title>
    <PostHog />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
