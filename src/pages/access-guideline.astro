---
import GuidelinePage from "../components/guideline/guideline-page.astro";
import { siteConfig } from "../config/site";
import { busRoutes, parking, railRoutes, rideHailing, tips, venueAccess } from "../data/access";

const routeGroups = [
  { id: "rail", title: "By train (MRT, KRL, LRT)", routes: railRoutes },
  { id: "bus", title: "By Transjakarta", routes: busRoutes },
];
---

<GuidelinePage
  title="Access Guideline"
  subtitle="How to get to Usmar Ismail Hall by LRT, Transjakarta, ride-hailing, motorbike or car."
  description="How to reach Usmar Ismail Hall for IDSW 2026: LRT and Transjakarta routes, ride-hailing and parking."
  canonicalPath="/access-guideline">
  <section aria-labelledby="venue-title">
    <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:p-8">
      <h2 id="venue-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
        {siteConfig.event.venue}
      </h2>
      <p class="mt-2 text-sm text-neutral-600 sm:text-base">{venueAccess.address}</p>
      <p class="mt-1 text-sm text-neutral-600 sm:text-base">{venueAccess.landmark}</p>
      <a
        href={venueAccess.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90">
        Open in Google Maps
      </a>

      <h3 class="mt-8 text-sm font-semibold tracking-wider text-neutral-500 uppercase">Nearest stops</h3>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {venueAccess.nearestStops.map((stop) => (
          <li class="rounded-xl border border-neutral-200 bg-neutral-50 p-4">
            <p class="text-xs font-semibold text-primary">{stop.mode}</p>
            <p class="mt-0.5 text-sm font-semibold text-neutral-900">{stop.name}</p>
            <p class="mt-0.5 text-xs text-neutral-600">{stop.walk} on foot</p>
          </li>
        ))}
      </ul>

      <h3 class="mt-8 text-sm font-semibold tracking-wider text-neutral-500 uppercase">
        Final walking directions (from either stop)
      </h3>
      <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm text-neutral-700 sm:text-base">
        {venueAccess.walking.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </div>
  </section>

  {routeGroups.map((group) => (
    <section aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`} class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
        {group.title}
      </h2>
      <div class="mt-6 space-y-3">
        {group.routes.map((route) => (
          <details class="group rounded-xl border border-neutral-200 bg-white p-4 shadow-xs">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-neutral-900 sm:text-base">From {route.from}</span>
                <span class="mt-1.5 flex flex-wrap gap-1.5">
                  {route.badges.map((badge) => (
                    <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-semibold text-primary">
                      {badge}
                    </span>
                  ))}
                </span>
              </span>
              <svg
                class="h-4 w-4 shrink-0 text-neutral-500 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <ol class="mt-4 list-decimal space-y-1.5 border-t border-neutral-100 pt-3 pl-5 text-sm text-neutral-700">
              {route.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </details>
        ))}
      </div>
    </section>
  ))}

  <section aria-labelledby="ride-title">
    <h2 id="ride-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
      Ride-hailing (Gojek / Grab)
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-neutral-600 sm:text-base">{rideHailing.intro}</p>
    <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm text-neutral-700 sm:text-base">
      {rideHailing.pins.map((pin) => (
        <li>{pin}</li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="parking-title">
    <h2 id="parking-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
      Parking
    </h2>
    <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50/60 p-5 text-sm text-blue-950 sm:text-base">
      <p>{parking.intro}</p>
      <p class="mt-1.5">{parking.overflow}</p>
    </div>
  </section>

  <section aria-labelledby="tips-title">
    <h2 id="tips-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
      Travel tips
    </h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-neutral-700 sm:text-base">
      {tips.map((tip) => (
        <li>{tip}</li>
      ))}
    </ul>
  </section>
</GuidelinePage>
