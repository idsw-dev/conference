---
import type { Faq } from "../@types/faq";
import type { SocialMedia } from "../@types/social-media";
import About from "../components/sections/about.astro";
import Cfp from "../components/sections/cfp.astro";
import CommunityPartners from "../components/sections/community-partners.astro";
import FaqSection from "../components/sections/faq-section.astro";
import Footer from "../components/sections/footer.astro";
import Hero from "../components/sections/hero.astro";
import PreviousEvents from "../components/sections/previous-events.astro";
import SponsorsPlaceholder from "../components/sections/sponsors-placeholder.astro";
import Layout from "../layout.astro";

const faq = import.meta.glob("../data/faq.json", { eager: true });
const socialMediasJson = import.meta.glob("../data/social-media.json", { eager: true });

const faqData: Faq[] = Object.values(faq).map((item) => (item as { default: Faq[] }).default)[0];
const socialMedias: SocialMedia[] = Object.values(socialMediasJson).map(
  (item) => (item as { default: SocialMedia[] }).default,
)[0];
---

<Layout>
  <Hero />
  <About />
  <Cfp />
  <SponsorsPlaceholder />
  <CommunityPartners />
  <PreviousEvents />
  <FaqSection data={faqData} />
  <Footer socialMedias={socialMedias} />
</Layout>
