---
import GuidelinePage from "../components/guideline/guideline-page.astro";
import Steps from "../components/guideline/steps.astro";
import { siteConfig } from "../config/site";
import schedule from "../data/schedule.json";
import { withBasePath } from "../lib/paths";

const bring = [
  "A valid ID card or passport.",
  "The QR code from your ticket email. Save a screenshot in case your signal is weak.",
];

const steps = [
  {
    title: "Go to the Check-in Desk",
    desc: "Head to the check-in (registration) desk when you reach the venue.",
  },
  {
    title: "Show your ID and QR code",
    desc: "Show both at the desk.",
  },
  {
    title: "Get checked in",
    desc: "The crew will check you in. After that you are ready to enter.",
  },
];

const registration = schedule.days.flatMap((day) =>
  day.sessions
    .filter((session) => session.kind === "registration")
    .map((session) => ({ label: day.day, time: `${session.start}–${session.end}` })),
);
---

<GuidelinePage
  title="Check-in Guideline"
  subtitle="What to bring and where to go when you arrive, so check-in is quick."
  description="How to check in at IDSW 2026: where the check-in desk is, and what to prepare."
  canonicalPath="/check-in-guideline">
  <section aria-labelledby="bring-title">
    <h2 id="bring-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
      Before you arrive
    </h2>
    <p class="mt-2 text-sm text-neutral-600 sm:text-base">Have these ready:</p>
    <ul class="mt-4 max-w-2xl space-y-2 text-sm text-neutral-700 sm:text-base">
      {bring.map((item) => (
        <li class="flex gap-3 rounded-xl border border-neutral-200 bg-white p-4 shadow-xs">
          <span aria-hidden="true" class="mt-0.5 font-bold text-primary">
            ✓
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="checkin-title">
    <h2 id="checkin-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
      At the venue
    </h2>
    <div class="mt-6">
      <Steps steps={steps} />
    </div>
  </section>

  <section aria-labelledby="registration-title">
    <h2 id="registration-title" class="font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
      Registration hours
    </h2>
    <dl class="mt-4 grid max-w-sm grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm text-neutral-700">
      {registration.map((day) => (
        <>
          <dt class="font-semibold text-neutral-900">{day.label}</dt>
          <dd class="tabular-nums">
            {day.time} {siteConfig.event.timezone}
          </dd>
        </>
      ))}
    </dl>
  </section>

  <section aria-labelledby="where-title">
    <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-6 sm:p-8">
      <h2 id="where-title" class="font-display text-2xl font-bold tracking-tight text-blue-950 sm:text-3xl">
        Find the Check-in Desk
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-blue-900/90 sm:text-base">
        See where the Check-in Desk is on the venue floor plan.
      </p>
      <a
        href={withBasePath("/day-guideline#venue")}
        class="mt-4 inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90">
        Open the venue map
      </a>
    </div>
  </section>
</GuidelinePage>
