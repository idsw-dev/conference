---
import { siteConfig } from "../../config/site";
---

{
  /*
    THESIS: A quiet strip right after the partnership letter, not a logo wall.
    No cards, no borders, no "proudly presented by" fanfare. The label is smaller
    than the logos. Logos sit at a fixed height; square and wide marks both fit.
    ADD A COMMUNITY: append one object to siteConfig.communities.
  */
}

<section class="border-b border-neutral-100 bg-white" aria-label="Community partners">
  <div class="container-site flex flex-col items-center gap-4 py-12 sm:py-14">
    <p class="text-xs font-medium tracking-[0.16em] text-neutral-400 uppercase">
      Community partners
    </p>

    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-5 sm:gap-x-16">
      {
        siteConfig.communities.map((community) => (
          <li>
            <a
              href={community.url}
              target="_blank"
              rel="noopener noreferrer"
              title={`Visit ${community.name}`}
              class="group inline-flex items-center justify-center rounded-lg outline-none transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] hover:brightness-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              data-ph-event="community_partner_click"
              data-ph-location="community-partners"
              data-ph-community={community.name}>
              <img
                src={community.logo}
                alt={`${community.name} logo`}
                loading="lazy"
                class="h-11 w-auto max-w-[12rem] object-contain opacity-80 transition-opacity duration-200 group-hover:opacity-100 sm:h-14 sm:max-w-[14rem]"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
