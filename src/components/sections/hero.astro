---
import { siteConfig } from "../../config/site";
import { isCfpOpen } from "../../lib/cfp";
import CfpCountdown from "../cfp-countdown.astro";
import Button from "../ui/button.astro";

const cfpOpen = isCfpOpen();
---

<section id="hero" class="hero-gradient hero-stage relative overflow-hidden text-white">
  <div class="hero-accent" aria-hidden="true">
    <div class="hero-accent-radiance"></div>
    <div class="hero-accent-cyan"></div>
    <div class="hero-accent-violet"></div>
  </div>

  <div class="container-site relative z-10 flex flex-col items-center text-center">
    <h1
      class="font-display max-w-4xl text-[1.7rem] leading-[1.25] font-extrabold tracking-tight text-balance sm:text-4xl sm:leading-[1.12] md:text-5xl lg:text-6xl xl:text-7xl">
      {siteConfig.event.tagline}
    </h1>

    <div
      class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm leading-relaxed text-white/80 sm:mt-8 sm:text-base">
      <a
        href={siteConfig.event.calendarUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Add to Google Calendar"
        class="whitespace-nowrap text-white underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white">
        {siteConfig.event.dates}
      </a>
      <a
        href={siteConfig.event.venueUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="whitespace-nowrap text-white underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white">
        {siteConfig.event.venue}
      </a>
    </div>

    <div
      class="mt-8 flex w-full max-w-sm flex-col items-center gap-3 sm:mt-10 sm:w-auto sm:max-w-none sm:flex-row sm:gap-4">
      {
        siteConfig.tickets.enabled && (
          <Button
            href={siteConfig.tickets.url}
            variant="secondary"
            external
            class="w-full sm:w-auto"
            capture="ticket_cta"
            captureLocation="hero">
            {siteConfig.tickets.label}
          </Button>
        )
      }
      {
        cfpOpen && (
          <Button href="/#cfp" variant={siteConfig.tickets.enabled ? "outline" : "secondary"} class="w-full sm:w-auto">
            Submit a proposal
          </Button>
        )
      }
      {
        !siteConfig.tickets.enabled && !cfpOpen && (
          <Button href="/#previous-events" variant="outline" class="w-full sm:w-auto">
            See previous events
          </Button>
        )
      }
    </div>

    <CfpCountdown />
  </div>
</section>
