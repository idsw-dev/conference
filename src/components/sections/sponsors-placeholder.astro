---
import { Image } from "astro:assets";
import { withBasePath } from "../../lib/paths";
import { siteConfig } from "../../config/site";
import Button from "../ui/button.astro";

const { prospectusUrl, email } = siteConfig.sponsors;
const { partners, silverPartners, digitalPartners } = siteConfig;

function logoSize(logo: { width: number; height: number }, tier: "platinum" | "silver" | "digital") {
  const ratio = logo.width / logo.height;
  if (tier === "platinum") {
    if (ratio >= 4) return "h-12 w-52 sm:h-14 sm:w-64";
    if (ratio >= 2) return "h-18 w-48 sm:h-20 sm:w-56";
    return "h-20 w-20 sm:h-24 sm:w-24";
  }
  if (tier === "silver") {
    if (ratio >= 4) return "h-11 w-48 sm:h-12 sm:w-56";
    if (ratio >= 2) return "h-14 w-44 sm:h-16 sm:w-48";
    return "h-16 w-16 sm:h-20 sm:w-20";
  }
  if (ratio >= 4) return "h-8 w-36 sm:h-9 sm:w-44";
  if (ratio >= 2) return "h-12 w-36 sm:h-14 sm:w-40";
  return "h-14 w-14 sm:h-16 sm:w-16";
}
---

{/*
    THESIS: A partnership letter, not a pricing page. No stats, no Gold/Platinum cards.
    OWN-WORLD: White paper after the navy CFP band. PDF and email. Reading measure.
    STORY: Community conference, one hall. Download the prospectus or write the partnership desk.
    FIRST VIEWPORT: Short letter, two actions.
    FORM: SmashingConf-style partnership note.
  */}

<section id="sponsors" class="section-surface">
  <div class="container-site pt-16 pb-10 sm:pt-20 sm:pb-12 md:pt-28 md:pb-14">
    <div class="max-w-2xl">
      <h2 class="section-heading text-neutral-900">Partner with IDSW</h2>

      <div class="mt-5 space-y-4 text-base leading-relaxed text-neutral-700 sm:text-lg">
        <p>
          IDSW is run by PERKODI and Indonesia's developer communities. Partners sit in the same hall as the talks: one
          track, two days, Usmar Ismail Hall.
        </p>
        <p>
          Last year SerpApi took the title slot. This year is open. We would rather build a package around what you need
          than sell you a banner.
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:mt-10 sm:flex-row sm:items-center sm:gap-6">
        <Button
          href={withBasePath(prospectusUrl)}
          variant="primary"
          external
          class="w-full text-center sm:w-auto"
          capture="sponsor_prospectus_cta"
          captureLocation="sponsors">
          Download the prospectus
        </Button>
        <a
          href={`mailto:${email}`}
          class="hover:text-primary hover:decoration-primary text-center text-sm font-medium text-neutral-700 underline decoration-neutral-300 underline-offset-4 transition-colors"
          data-ph-event="sponsor_email_cta"
          data-ph-location="sponsors">
          {email}
        </a>
      </div>
    </div>

    {(partners.length > 0 || silverPartners.length > 0 || digitalPartners.length > 0) && (
      <div class="mt-14 border-t border-neutral-100 pt-10 sm:mt-16 sm:pt-12">
        {partners.length > 0 && (
          <div>
            <p class="w-full text-center text-xs font-bold tracking-[0.18em] text-neutral-600 uppercase sm:text-left">
              Platinum partners
            </p>
            <ul class="mt-7 grid w-full max-w-[42rem] grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
              {partners.map((partner) => (
                <li class="flex justify-center">
                  <a
                    href={partner.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`Visit ${partner.name}`}
                    class="group focus-visible:outline-primary flex h-36 max-w-80 px-6 w-full items-center justify-center rounded-lg outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
                    data-ph-event="partner_click"
                    data-ph-location="sponsors"
                    data-ph-partner={partner.name}>
                    <Image
                      src={partner.logo}
                      width={400}
                      alt={`${partner.name} logo`}
                      loading="lazy"
                      class:list={[
                        logoSize(partner.logo, "platinum"),
                        "max-w-full object-contain transition-transform duration-200 group-hover:scale-105",
                      ]}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {silverPartners.length > 0 && (
          <div class="mt-10 border-t border-neutral-100 pt-8 sm:mt-12 sm:pt-10">
            <p class="w-full text-center text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase sm:text-left">
              Silver partners
            </p>
            <ul class="mt-6 grid w-full max-w-[42rem] grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
              {silverPartners.map((partner) => (
                <li class="flex justify-center">
                  <a
                    href={partner.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`Visit ${partner.name}`}
                    class="group focus-visible:outline-primary flex h-28 max-w-72 px-6 w-full items-center justify-center rounded-lg outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
                    data-ph-event="partner_click"
                    data-ph-location="sponsors"
                    data-ph-partner={partner.name}>
                    <Image
                      src={partner.logo}
                      width={400}
                      alt={`${partner.name} logo`}
                      loading="lazy"
                      class:list={[
                        logoSize(partner.logo, "silver"),
                        "max-w-full object-contain transition-transform duration-200 group-hover:scale-105",
                      ]}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {digitalPartners.length > 0 && (
          <div class="mt-10 border-t border-neutral-100 pt-8 sm:mt-12 sm:pt-10">
            <p class="w-full text-center text-xs font-semibold tracking-[0.16em] text-neutral-400 uppercase sm:text-left">
              Digital partners
            </p>
            <ul class="mt-6 grid w-full max-w-[34rem] grid-cols-1 gap-4 min-[400px]:grid-cols-2 sm:gap-8">
              {digitalPartners.map((partner) => (
                <li class="flex justify-center">
                  <a
                    href={partner.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`Visit ${partner.name}`}
                    class="group focus-visible:outline-primary flex h-24 max-w-60 px-4 w-full items-center justify-center rounded-lg outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
                    data-ph-event="partner_click"
                    data-ph-location="sponsors"
                    data-ph-partner={partner.name}>
                    <Image
                      src={partner.logo}
                      width={400}
                      alt={`${partner.name} logo`}
                      loading="lazy"
                      class:list={[
                        logoSize(partner.logo, "digital"),
                        "max-w-full object-contain opacity-85 transition-all duration-200 group-hover:opacity-100 group-hover:scale-105",
                      ]}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</section>
