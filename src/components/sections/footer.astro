---
import { Image } from "astro:assets";
import idswLogo from "../../data/images/idsw-logo.png";
import { withBasePath } from "../../lib/paths";
import { SiFacebook, SiInstagram, SiThreads, SiX } from "@icons-pack/react-simple-icons";
import { Mail } from "lucide-react";
import type { SocialMedia } from "../../@types/social-media";
import defaultSocialMedias from "../../data/social-media.json";
import { siteConfig } from "../../config/site";

interface Props {
  socialMedias?: SocialMedia[];
}

const { socialMedias = defaultSocialMedias as SocialMedia[] } = Astro.props;
---

<footer class="footer-gradient text-white">
  <div class="container-site py-16 md:py-20">
    <div class="flex flex-col gap-8 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-8">
      <div class="min-w-0 flex-1">
        <p class="font-display text-2xl font-semibold md:text-3xl">{siteConfig.event.name}</p>
        <p class="mt-2 text-white/80">{siteConfig.event.dateRange}</p>
        <a
          href={siteConfig.event.venueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="venue-link mt-1 inline-block text-white/70">
          {siteConfig.event.venue}
        </a>
        <dl class="mt-2 grid w-fit grid-cols-[auto_auto] gap-x-3 text-xs leading-relaxed text-white/60 sm:text-sm">
          {siteConfig.event.days.map((day) => (
            <>
              <dt class="text-white/40">{day.label}</dt>
              <dd class="tabular-nums">
                {day.time} {siteConfig.event.timezone}
              </dd>
            </>
          ))}
        </dl>
      </div>

      <div class="flex w-full items-center justify-between gap-5 sm:w-auto sm:flex-col sm:items-end sm:gap-6">
        <Image src={idswLogo} width={320} alt="IDSW 2026" class="h-14 w-auto opacity-95 sm:h-16 md:h-20" />
        <a
          href={siteConfig.organizer.url}
          target="_blank"
          rel="noopener noreferrer"
          title={siteConfig.organizer.fullName}
          class="group inline-flex flex-col items-start gap-2.5"
          data-ph-event="organizer_click">
          <span class="text-xs font-medium tracking-[0.16em] text-white/50 uppercase">Organized by</span>
          <Image
            src={siteConfig.organizer.logoWhite}
            width={460}
            alt={siteConfig.organizer.name}
            class="h-8 w-auto opacity-80 transition-opacity duration-200 group-hover:opacity-100"
          />
        </a>
      </div>
    </div>
  </div>

  <div id="contact" class="border-t border-white/10">
    <div class="container-site py-10">
      <div class="flex flex-row flex-wrap items-center justify-between gap-6">
        <div class="min-w-0">
          <h2 class="text-lg font-semibold">Updates & Questions</h2>
          <p class="mt-1 text-sm text-white/70">Follow us for news.</p>
        </div>

        <ul class="flex flex-wrap gap-3">
          {socialMedias.map((socmed) => {
            const linkClass =
              "flex h-12 w-12 items-center justify-center rounded-lg border border-white/20 bg-white/10 transition-colors hover:bg-white/20";

            if (socmed.name === "Email") {
              return (
                <li>
                  <a href={socmed.url} class={linkClass} title={socmed.name}>
                    <Mail className="h-5 w-5" />
                  </a>
                </li>
              );
            }
            if (socmed.name === "X") {
              return (
                <li>
                  <a href={socmed.url} target="_blank" rel="noopener noreferrer" class={linkClass} title={socmed.name}>
                    <SiX className="h-5 w-5" />
                  </a>
                </li>
              );
            }
            if (socmed.name === "Instagram") {
              return (
                <li>
                  <a href={socmed.url} target="_blank" rel="noopener noreferrer" class={linkClass} title={socmed.name}>
                    <SiInstagram className="h-5 w-5" />
                  </a>
                </li>
              );
            }
            if (socmed.name === "Threads") {
              return (
                <li>
                  <a href={socmed.url} target="_blank" rel="noopener noreferrer" class={linkClass} title={socmed.name}>
                    <SiThreads className="h-5 w-5" />
                  </a>
                </li>
              );
            }
            if (socmed.name === "Facebook") {
              return (
                <li>
                  <a href={socmed.url} target="_blank" rel="noopener noreferrer" class={linkClass} title={socmed.name}>
                    <SiFacebook className="h-5 w-5" />
                  </a>
                </li>
              );
            }
            return null;
          })}
        </ul>
      </div>

      <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-2.5 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex sm:flex-wrap sm:gap-6 sm:text-sm">
        {siteConfig.nav.map((item) => (
          <a
            href={withBasePath(item.href)}
            class="transition-colors hover:text-white"
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}>
            {item.name}
          </a>
        ))}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-white/10 pt-6 text-xs text-white/50">
        <a href={withBasePath("/code-of-conduct")} class="transition-colors hover:text-white">
          {" "}
          Code of Conduct{" "}
        </a>
        <a href={withBasePath("/terms-of-service")} class="transition-colors hover:text-white">
          {" "}
          Terms of Service{" "}
        </a>
        <a href={withBasePath("/privacy-policy")} class="transition-colors hover:text-white">
          {" "}
          Privacy Policy{" "}
        </a>
      </div>
    </div>
  </div>
</footer>
