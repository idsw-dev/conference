---
import { SiFacebook, SiInstagram, SiThreads, SiX } from "@icons-pack/react-simple-icons";
import { Mail } from "lucide-react";
import type { SocialMedia } from "../../@types/social-media";
import { siteConfig } from "../../config/site";

interface Props {
  socialMedias: SocialMedia[];
}

const { socialMedias } = Astro.props;
---

<footer class="footer-gradient text-white">
  <div class="container-site py-16 md:py-20">
    <div class="flex flex-row flex-wrap items-center justify-between gap-6 sm:gap-8">
      <div class="min-w-0 flex-1">
        <p class="font-display text-2xl font-semibold md:text-3xl">{siteConfig.event.name}</p>
        <p class="mt-2 text-white/80">{siteConfig.event.dates}</p>
        <a
          href={siteConfig.event.venueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="venue-link mt-1 inline-block text-white/70">
          {siteConfig.event.venue}
        </a>
      </div>

      <div class="shrink-0">
        <img src="/idsw-logo.png" alt="IDSW 2026" class="h-14 w-auto opacity-95 sm:h-16 md:h-20" />
      </div>
    </div>
  </div>

  <div id="contact" class="border-t border-white/10">
    <div class="container-site py-10">
      <div class="flex flex-row flex-wrap items-center justify-between gap-6">
        <div class="min-w-0">
          <h2 class="text-lg font-semibold">Updates & Questions</h2>
          <p class="mt-1 text-sm text-white/70">Follow us for news. Email if you're stuck.</p>
        </div>

        <ul class="flex flex-wrap gap-3">
          {
            socialMedias.map((socmed) => {
              const linkClass =
                "flex h-12 w-12 items-center justify-center rounded-lg border border-white/20 bg-white/10 transition-colors hover:bg-white/20";

              if (socmed.name === "Email") {
                return (
                  <li>
                    <a href={socmed.url} class={linkClass} title={socmed.name}>
                      <Mail className="h-5 w-5" />
                    </a>
                  </li>
                );
              }
              if (socmed.name === "X") {
                return (
                  <li>
                    <a
                      href={socmed.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                      title={socmed.name}>
                      <SiX className="h-5 w-5" />
                    </a>
                  </li>
                );
              }
              if (socmed.name === "Instagram") {
                return (
                  <li>
                    <a
                      href={socmed.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                      title={socmed.name}>
                      <SiInstagram className="h-5 w-5" />
                    </a>
                  </li>
                );
              }
              if (socmed.name === "Threads") {
                return (
                  <li>
                    <a
                      href={socmed.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                      title={socmed.name}>
                      <SiThreads className="h-5 w-5" />
                    </a>
                  </li>
                );
              }
              if (socmed.name === "Facebook") {
                return (
                  <li>
                    <a
                      href={socmed.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                      title={socmed.name}>
                      <SiFacebook className="h-5 w-5" />
                    </a>
                  </li>
                );
              }
              return null;
            })
          }
        </ul>
      </div>

      <div class="mt-8 flex flex-wrap gap-4 border-t border-white/10 pt-6 text-xs text-white/60 sm:gap-6 sm:text-sm">
        {
          siteConfig.nav.map((item) => (
            <a
              href={item.href}
              class="transition-colors hover:text-white"
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}>
              {item.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
