---
import { Image } from "astro:assets";
import { withBasePath } from "../../lib/paths";
import recapPoster from "../../data/images/idsw-2025-recap.jpg";
import { siteConfig } from "../../config/site";
import SectionHeader from "../ui/section-header.astro";
---

<section id="about" class="section-surface py-16 sm:py-20 md:py-28">
  <div class="container-site">
    <div class="grid items-center gap-8 sm:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <div class="overflow-hidden rounded-lg bg-navy">
          <video
            id="about-recap"
            class="aspect-video w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={recapPoster.src}
            aria-label="Recap from IDSW 2025">
            <source src={withBasePath("/video/idsw-2025.av1.mp4")} type='video/mp4; codecs="av01.0.05M.08"' />
            <source src={withBasePath("/video/idsw-2025.mp4")} type="video/mp4" />
          </video>
        </div>
      </div>

      <div>
        <SectionHeader title="About the Event" class="!text-left" />
        <p class="mt-5 text-base leading-relaxed text-neutral-600 sm:text-lg">{siteConfig.about}</p>
        <div class="mt-8 border-t border-neutral-200 pt-6">
          <a
            href={siteConfig.organizer.url}
            target="_blank"
            rel="noopener noreferrer"
            title={siteConfig.organizer.fullName}
            class="group inline-flex flex-col items-start gap-2.5"
            data-ph-event="organizer_click">
            <span class="text-xs font-medium tracking-[0.16em] text-neutral-400 uppercase">Organized by</span>
            <Image
              src={siteConfig.organizer.logo}
              width={460}
              alt={siteConfig.organizer.name}
              class="h-9 w-auto opacity-95 transition-opacity duration-200 group-hover:opacity-70 sm:h-10"
            />
          </a>
          <p class="mt-4 text-sm leading-relaxed text-neutral-500 sm:text-base">
            Same crew behind RubyConfID, JSDay, SEA Machine Learning School, and PyCon Indonesia.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("about-recap");
  if (video instanceof HTMLVideoElement) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      video.removeAttribute("autoplay");
      video.pause();
      video.preload = "none";
    } else {
      const play = () => {
        video.play().catch(() => {});
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) play();
            else video.pause();
          }
        },
        { threshold: 0.2 },
      );

      observer.observe(video);
      video.addEventListener("loadeddata", play, { once: true });
    }
  }
</script>
