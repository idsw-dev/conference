---
import { siteConfig } from "../../config/site";
import SectionHeader from "../ui/section-header.astro";
---

<section id="about" class="section-surface py-16 sm:py-20 md:py-28">
  <div class="container-site">
    <div class="grid items-center gap-8 sm:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <div class="overflow-hidden rounded-2xl shadow-xl">
          <img
            src="/img-placeholder.jpg"
            alt="Audience at a previous IDSW conference"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div>
        <SectionHeader title="About the Event" class="!text-left" />
        <p class="mt-4 text-base leading-relaxed text-neutral-600 sm:mt-6 sm:text-lg">
          {siteConfig.about}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-500 sm:mt-4 sm:text-base">
          Run by <strong class="font-semibold text-neutral-900">PERKODI</strong>. Same crew behind RubyConfID, JSDay,
          SEA Machine Learning School, and PyCon Indonesia.
        </p>
      </div>
    </div>
  </div>
</section>
