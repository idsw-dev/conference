---
import { Image } from "astro:assets";
import { siteConfig } from "../../config/site";
import SectionHeader from "../ui/section-header.astro";

const speakerPhotos = import.meta.glob<{ default: ImageMetadata }>("../../data/images/speakers/*.{jpg,jpeg,png,webp}", {
  eager: true,
});

const photoByName = Object.fromEntries(
  Object.entries(speakerPhotos).map(([path, mod]) => [path.replace(/^.*\//, "").replace(/\.[^.]+$/, ""), mod.default]),
);
---

<section id="keynote-speakers" class="section-tint py-16 sm:py-20 md:py-28">
  <div class="container-site">
    <SectionHeader title="Keynote Speakers" class="!text-left" />

    <div class="relative mt-8 sm:mt-12">
      <div
        class="keynote-carousel flex gap-4 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory -mx-6 px-6 lg:mx-0 lg:px-0 lg:grid lg:grid-cols-5 lg:gap-6 lg:overflow-visible lg:pb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {
          siteConfig.keynotes.map((keynote, idx) => {
            const photo = photoByName[keynote.photo];
            return (
              <button
                type="button"
                class="keynote-card aspect-[4/5] w-[75vw] max-w-[280px] shrink-0 snap-center sm:w-[45vw] sm:max-w-[300px] lg:w-full lg:max-w-none cursor-pointer rounded-lg bg-transparent text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                aria-pressed="false"
                data-card-index={idx}
                aria-label={`${keynote.name}, ${keynote.position}`}>
                <div class="keynote-card-inner relative h-full w-full">
                  <div class="keynote-card-face relative overflow-hidden rounded-lg bg-navy shadow-sm">
                    {photo && (
                      <Image
                        src={photo}
                        alt={keynote.name}
                        width={400}
                        height={480}
                        sizes="(min-width: 1024px) 20vw, 75vw"
                        class="h-full w-full object-cover"
                      />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-navy/95 via-navy/20 to-transparent" />
                    <div class="absolute inset-x-0 bottom-0 p-3.5 sm:p-4">
                      <div class="flex items-end justify-between gap-2">
                        <p class="font-display text-sm leading-snug font-semibold text-white sm:text-base">
                          {keynote.name}
                        </p>
                        <span class="inline-flex shrink-0 items-center gap-1 rounded bg-white/20 px-1.5 py-0.5 text-[10px] font-medium text-white/95 backdrop-blur-sm lg:hidden">
                          Bio ↺
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="keynote-card-face keynote-card-back flex flex-col justify-between rounded-lg border border-neutral-200 bg-white p-3.5 sm:p-5 shadow-sm">
                    <div class="overflow-y-auto pr-0.5">
                      <p class="font-display text-sm leading-snug font-semibold text-neutral-900 sm:text-base">
                        {keynote.name}
                      </p>
                      <p class="mt-1.5 text-xs leading-relaxed font-medium text-primary sm:text-sm">
                        {keynote.position}
                      </p>
                      <p class="mt-2.5 text-xs leading-relaxed text-neutral-600 sm:text-sm">
                        {keynote.brief ?? "Bio coming soon."}
                      </p>
                    </div>
                    <div class="mt-2 pt-2 border-t border-neutral-100 flex items-center justify-between text-[10px] text-neutral-400 lg:hidden">
                      <span>Tap to flip back</span>
                      <span>↺</span>
                    </div>
                  </div>
                </div>
              </button>
            );
          })
        }
      </div>

      <!-- Mobile carousel indicators & hint -->
      <div class="mt-3 flex justify-start px-1 lg:hidden">
        <div class="flex items-center gap-1.5" id="carousel-dots" aria-hidden="true">
          {
            siteConfig.keynotes.map((_, i) => (
              <span
                class={`carousel-dot h-1.5 rounded-full transition-all duration-300 ${i === 0 ? "w-5 bg-primary" : "w-1.5 bg-neutral-300"}`}
                data-dot-index={i}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .keynote-card {
    perspective: 1000px;
  }

  .keynote-card-inner {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transform-style: preserve-3d;
  }

  .keynote-card.is-flipped .keynote-card-inner {
    transform: rotateY(180deg);
  }

  @media (hover: hover) {
    .keynote-card:hover .keynote-card-inner {
      transform: rotateY(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .keynote-card-inner {
      transition: none;
    }
  }

  .keynote-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .keynote-card-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  let startX = 0;
  let startY = 0;

  document.querySelectorAll<HTMLButtonElement>(".keynote-card").forEach((card) => {
    card.addEventListener("pointerdown", (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });

    card.addEventListener("click", (e) => {
      const dx = Math.abs((e as MouseEvent).clientX - startX);
      const dy = Math.abs((e as MouseEvent).clientY - startY);
      // Ignore if user was swiping / scrolling
      if (dx > 8 || dy > 8) {
        return;
      }
      const flipped = card.classList.toggle("is-flipped");
      card.setAttribute("aria-pressed", String(flipped));
    });
  });

  const carousel = document.querySelector<HTMLElement>(".keynote-carousel");
  const dots = document.querySelectorAll<HTMLElement>(".carousel-dot");

  if (carousel && dots.length > 0) {
    carousel.addEventListener(
      "scroll",
      () => {
        const scrollLeft = carousel.scrollLeft;
        const card = carousel.querySelector<HTMLElement>(".keynote-card");
        if (!card) return;
        const cardWidth = card.offsetWidth + 16;
        const activeIndex = Math.min(dots.length - 1, Math.max(0, Math.round(scrollLeft / cardWidth)));

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add("w-5", "bg-primary");
            dot.classList.remove("w-1.5", "bg-neutral-300");
          } else {
            dot.classList.remove("w-5", "bg-primary");
            dot.classList.add("w-1.5", "bg-neutral-300");
          }
        });
      },
      { passive: true },
    );
  }
</script>
