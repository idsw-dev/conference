---
import { Image } from "astro:assets";
import { siteConfig } from "../../config/site";
import SectionHeader from "../ui/section-header.astro";

const speakerPhotos = import.meta.glob<{ default: ImageMetadata }>("../../data/images/speakers/*.{jpg,jpeg,png,webp}", {
  eager: true,
});

const photoByName = Object.fromEntries(
  Object.entries(speakerPhotos).map(([path, mod]) => [path.replace(/^.*\//, "").replace(/\.[^.]+$/, ""), mod.default]),
);
---

<section id="keynote-speakers" class="section-tint py-16 sm:py-20 md:py-28">
  <div class="container-site">
    <SectionHeader title="Keynote Speakers" />

    <div class="mt-8 grid grid-cols-2 gap-3 sm:mt-12 sm:gap-6 lg:grid-cols-4">
      {siteConfig.keynotes.map((keynote) => {
        const photo = photoByName[keynote.photo];
        return (
          <button
            type="button"
            class="keynote-card aspect-[4/5] w-full cursor-pointer rounded-lg bg-transparent text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            aria-pressed="false"
            aria-label={`${keynote.name}, ${keynote.position}`}>
            <div class="keynote-card-inner relative h-full w-full">
              <div class="keynote-card-face relative overflow-hidden rounded-lg bg-navy">
                {photo && (
                  <Image
                    src={photo}
                    alt={keynote.name}
                    width={400}
                    height={480}
                    sizes="(min-width: 1024px) 25vw, 50vw"
                    class="h-full w-full object-cover"
                  />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-navy/95 via-navy/10 to-transparent" />
                <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
                  <p class="font-display text-sm leading-snug font-semibold text-white sm:text-base">{keynote.name}</p>
                </div>
              </div>

              <div class="keynote-card-face keynote-card-back flex flex-col overflow-y-auto rounded-lg border border-neutral-200 bg-white p-3 sm:p-5">
                <p class="font-display text-sm leading-snug font-semibold text-neutral-900 sm:text-base">
                  {keynote.name}
                </p>
                <p class="mt-2 text-xs leading-relaxed font-medium text-primary sm:text-sm">{keynote.position}</p>
                <p class="mt-3 text-sm leading-relaxed text-neutral-600 sm:text-base">
                  {keynote.brief ?? "Bio coming soon."}
                </p>
              </div>
            </div>
          </button>
        );
      })}
    </div>
  </div>
</section>

<style>
  .keynote-card {
    perspective: 1000px;
  }

  .keynote-card-inner {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transform-style: preserve-3d;
  }

  .keynote-card.is-flipped .keynote-card-inner {
    transform: rotateY(180deg);
  }

  @media (hover: hover) {
    .keynote-card:hover .keynote-card-inner {
      transform: rotateY(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .keynote-card-inner {
      transition: none;
    }
  }

  .keynote-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .keynote-card-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".keynote-card").forEach((card) => {
    card.addEventListener("click", () => {
      const flipped = card.classList.toggle("is-flipped");
      card.setAttribute("aria-pressed", String(flipped));
    });
  });
</script>
