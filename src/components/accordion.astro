---
import type { Faq } from "../@types/faq";
import { siteConfig } from "../config/site";
import socialMedias from "../data/social-media.json";
import { withBasePath } from "../lib/paths";

interface Props {
  data: Faq[];
  variant?: "light" | "dark";
}

const { data, variant = "dark" } = Astro.props;
const isLight = variant === "light";

// Answers are plain text. These exact strings become links wherever they appear.
const socialUrl = (name: string) => socialMedias.find((social) => social.name === name)?.url;
const autoLinks = [
  { text: new URL(siteConfig.stream.url).host, href: siteConfig.stream.url, capture: "stream_cta" },
  { text: "@idsw.dev", href: socialUrl("Instagram") },
  { text: "@idswdev", href: socialUrl("X") },
  { text: "idsw.ticketing@perkodi.org", href: "mailto:idsw.ticketing@perkodi.org" },
].filter((link): link is typeof link & { href: string } => Boolean(link.href));
const escapeRegExp = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
// The lookarounds stop a match inside a longer word, address or URL, e.g. "@idsw.dev" in "partners@idsw.dev".
const linkPattern = new RegExp(
  `(?<![\\w.@/-])(${autoLinks.map((link) => escapeRegExp(link.text)).join("|")})(?![\\w-])`,
);
// split() with a capture group puts the matched link text at odd indexes.
const linkify = (text: string) =>
  text.split(linkPattern).map((part, index) => ({
    part,
    link: index % 2 === 1 ? autoLinks.find((link) => link.text === part) : undefined,
  }));
const items = data.map((item) => ({
  ...item,
  link: item.link && { label: item.link.label, href: withBasePath(item.link.href) },
}));
const isExternal = (href: string) => href.startsWith("http");
const linkClass = isLight
  ? "font-medium text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:decoration-primary"
  : "font-medium text-white underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white";
---

<div class="flex flex-col gap-3 text-left">
  {items.map((item, i) => (
    <details
      open={i === 0}
      class:list={[
        "group overflow-hidden rounded-lg",
        isLight
          ? "border border-neutral-200/80 bg-white shadow-xs hover:border-primary/25 hover:shadow-sm"
          : "border border-white/10 bg-[#8BA6FF33]",
      ]}>
      <summary
        class="flex w-full cursor-pointer list-none items-center justify-between gap-3 p-4 text-left select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:gap-4 sm:p-5"
        aria-label={item.question}>
        <span class:list={["flex-1 text-sm font-semibold sm:text-base", isLight ? "text-neutral-900" : "text-white"]}>
          {item.question}
        </span>
        <span
          class:list={[
            "flex h-7 w-7 shrink-0 items-center justify-center rounded-full transition-transform duration-200 group-open:rotate-180 sm:h-8 sm:w-8",
            isLight ? "bg-neutral-100 text-neutral-500 group-open:bg-primary/10 group-open:text-primary" : "text-white",
          ]}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 sm:h-4 sm:w-4"
            aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </summary>
      <div class="px-4 pb-4 sm:px-5 sm:pb-5">
        <div class:list={["text-sm leading-relaxed sm:text-base", isLight ? "text-neutral-600" : "text-white/80"]}>
          {linkify(item.answer).map(({ part, link }) =>
            link ? (
              <a
                href={link.href}
                target={isExternal(link.href) ? "_blank" : undefined}
                rel={isExternal(link.href) ? "noopener noreferrer" : undefined}
                class={linkClass}
                data-ph-event={link.capture}
                data-ph-location={link.capture ? "faq" : undefined}
                set:text={part}
              />
            ) : (
              part
            ),
          )}
          {item.link && (
            <a
              href={item.link.href}
              target={isExternal(item.link.href) ? "_blank" : undefined}
              rel={isExternal(item.link.href) ? "noopener noreferrer" : undefined}
              class:list={["mt-2 block", linkClass]}
              set:text={item.link.label}
            />
          )}
        </div>
      </div>
    </details>
  ))}
</div>
