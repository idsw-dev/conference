---
import type { Faq } from "../@types/faq";

interface Props {
  data: Faq[];
  variant?: "light" | "dark";
}

const { data, variant = "dark" } = Astro.props;
const isLight = variant === "light";
---

<div class="flex flex-col gap-3 text-left">
  {
    data.map((item, i) => (
      <details
        open={i === 0}
        class:list={[
          "group overflow-hidden rounded-2xl",
          isLight
            ? "border border-neutral-200/80 bg-white shadow-xs hover:border-primary/25 hover:shadow-sm"
            : "border border-white/10 bg-[#8BA6FF33]",
        ]}>
        <summary
          class="flex w-full cursor-pointer list-none items-center justify-between gap-3 p-4 text-left select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:gap-4 sm:p-5"
          aria-label={item.question}>
          <span class:list={["flex-1 text-sm font-semibold sm:text-base", isLight ? "text-neutral-900" : "text-white"]}>
            {item.question}
          </span>
          <span
            class:list={[
              "flex h-7 w-7 shrink-0 items-center justify-center rounded-full transition-transform duration-200 group-open:rotate-180 sm:h-8 sm:w-8",
              isLight
                ? "bg-neutral-100 text-neutral-500 group-open:bg-primary/10 group-open:text-primary"
                : "text-white",
            ]}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 sm:h-4 sm:w-4"
              aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>
        <div class="px-4 pb-4 sm:px-5 sm:pb-5">
          <div class:list={["text-sm leading-relaxed sm:text-base", isLight ? "text-neutral-600" : "text-white/80"]}>
            {item.answer}
          </div>
        </div>
      </details>
    ))
  }
</div>
