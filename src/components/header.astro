---
import { siteConfig } from "../config/site";
---

<header class="site-header fixed top-0 right-0 left-0 z-50">
  <nav
    class="site-nav border-b border-transparent py-4 transition-[background-color,box-shadow,border-color,padding] duration-500 ease-out">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10">
      <input id="nav-toggle" type="checkbox" class="peer sr-only" />

      <div class="flex items-center justify-between">
        <a href="/" class="relative z-10 flex items-center">
          <img src="/idsw-logo.png" class="h-8 w-auto" alt="IDSW 2026" />
        </a>

        <label
          for="nav-toggle"
          class="site-nav-toggle relative z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-white md:hidden"
          aria-controls="site-nav-panel">
          <span class="sr-only">Menu</span>
          <svg
            class="site-nav-icon-open h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="site-nav-icon-close h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </label>

        <ul class="hidden items-center gap-1 md:flex">
          {
            siteConfig.nav.map((menu) => (
              <li>
                <a
                  href={menu.href}
                  target={menu.external ? "_blank" : undefined}
                  rel={menu.external ? "noopener noreferrer" : undefined}
                  class="site-nav-link inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium text-white/90 transition-colors hover:bg-white/10 hover:text-white"
                  data-ph-event={menu.name === "Tickets" ? "ticket_cta" : undefined}
                  data-ph-location={menu.name === "Tickets" ? "nav" : undefined}>
                  {menu.name}
                  {menu.external && (
                    <svg class="h-3.5 w-3.5 opacity-70" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M8 8h8v8M8 16 16 8"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="site-nav-panel" class="site-nav-panel mt-4 border-t border-white/10 pt-4">
        <ul class="flex flex-col">
          {
            siteConfig.nav.map((menu) => (
              <li class="w-full">
                <a
                  href={menu.href}
                  target={menu.external ? "_blank" : undefined}
                  rel={menu.external ? "noopener noreferrer" : undefined}
                  class="site-nav-link flex w-full items-center justify-between gap-3 rounded-lg px-3 py-3 text-base font-medium text-white/90 transition-colors hover:bg-white/10 hover:text-white"
                  data-ph-event={menu.name === "Tickets" ? "ticket_cta" : undefined}
                  data-ph-location={menu.name === "Tickets" ? "nav" : undefined}>
                  {menu.name}
                  {menu.external && (
                    <svg class="h-4 w-4 shrink-0 opacity-70" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M8 8h8v8M8 16 16 8"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector(".site-nav");
  const toggle = document.querySelector<HTMLInputElement>("#nav-toggle");
  const panel = document.querySelector(".site-nav-panel");
  const links = document.querySelectorAll(".site-nav-link");

  const setHeaderHeight = () => {
    if (!nav) return;
    const panelHeight = toggle?.checked && panel ? panel.getBoundingClientRect().height : 0;
    const height = nav.getBoundingClientRect().height - panelHeight;
    document.documentElement.style.setProperty("--site-header-height", `${Math.round(height)}px`);
  };

  const setScrolled = () => {
    nav?.classList.toggle("is-scrolled", window.scrollY > 24);
    requestAnimationFrame(setHeaderHeight);
  };

  const setMenuOpen = (open: boolean) => {
    if (toggle) toggle.checked = open;
    requestAnimationFrame(setHeaderHeight);
  };

  setScrolled();
  setHeaderHeight();
  window.addEventListener("scroll", setScrolled, { passive: true });
  nav?.addEventListener("transitionend", (event) => {
    if (event instanceof TransitionEvent && event.propertyName.includes("padding")) {
      setHeaderHeight();
    }
  });

  toggle?.addEventListener("change", () => requestAnimationFrame(setHeaderHeight));
  links.forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) setMenuOpen(false);
    setHeaderHeight();
  });
</script>
