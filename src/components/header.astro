---
import { siteConfig } from "../config/site";
---

<header class="site-header fixed top-0 right-0 left-0 z-50">
  <nav
    class="site-nav border-b border-transparent py-4 transition-[background-color,box-shadow,border-color,padding] duration-500 ease-out">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10">
      <div class="flex items-center justify-between">
        <a href="/" class="relative z-10 flex items-center">
          <img src="/idsw-logo.png" class="h-8 w-auto" alt="IDSW 2026" />
        </a>

        <button
          type="button"
          class="site-nav-toggle relative z-10 inline-flex h-10 w-10 items-center justify-center rounded-lg text-white md:hidden"
          aria-expanded="false"
          aria-label="Toggle menu">
          <svg
            class="site-nav-icon-open h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="site-nav-icon-close hidden h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>

        <ul class="hidden items-center gap-1 md:flex">
          {
            siteConfig.nav.map((menu) => (
              <li>
                <a
                  href={menu.href}
                  target={menu.external ? "_blank" : undefined}
                  rel={menu.external ? "noopener noreferrer" : undefined}
                  class="site-nav-link inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium text-white/90 transition-colors hover:bg-white/10 hover:text-white">
                  {menu.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-nav-panel mt-4 hidden border-t border-white/10 pt-4 md:hidden">
        <ul class="flex flex-col gap-1">
          {
            siteConfig.nav.map((menu) => (
              <li>
                <a
                  href={menu.href}
                  target={menu.external ? "_blank" : undefined}
                  rel={menu.external ? "noopener noreferrer" : undefined}
                  class="site-nav-link inline-flex items-center gap-1.5 rounded-lg px-3 py-3 text-base font-medium text-white/90 transition-colors hover:bg-white/10 hover:text-white">
                  {menu.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector(".site-nav");
  const toggle = document.querySelector(".site-nav-toggle");
  const panel = document.querySelector(".site-nav-panel");
  const iconOpen = document.querySelector(".site-nav-icon-open");
  const iconClose = document.querySelector(".site-nav-icon-close");
  const links = document.querySelectorAll(".site-nav-link");

  const setHeaderHeight = () => {
    if (!nav) return;
    const panelHeight = panel && !panel.classList.contains("hidden") ? panel.getBoundingClientRect().height : 0;
    const height = nav.getBoundingClientRect().height - panelHeight;
    document.documentElement.style.setProperty("--site-header-height", `${Math.round(height)}px`);
  };

  const setScrolled = () => {
    const scrolled = window.scrollY > 24;
    nav?.classList.toggle("is-scrolled", scrolled);
    requestAnimationFrame(setHeaderHeight);
  };

  const setMenuOpen = (open: boolean) => {
    panel?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
    nav?.classList.toggle("is-menu-open", open);
  };

  setScrolled();
  setHeaderHeight();
  window.addEventListener("scroll", setScrolled, { passive: true });
  nav?.addEventListener("transitionend", (event) => {
    if (event instanceof TransitionEvent && event.propertyName.includes("padding")) {
      setHeaderHeight();
    }
  });

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    setMenuOpen(open);
  });

  links.forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) setMenuOpen(false);
    setHeaderHeight();
  });
</script>
