---
import Layout from "../../layout.astro";
import Footer from "../sections/footer.astro";

interface TocItem {
  id: string;
  title: string;
}

interface Props {
  title: string;
  subtitle: string;
  toc: TocItem[];
  currentPath: string;
}

const { title, subtitle, toc, currentPath } = Astro.props;

const legalLinks = [
  { name: "Code of Conduct", href: "/code-of-conduct" },
  { name: "Terms of Service", href: "/terms-of-service" },
  { name: "Privacy Policy", href: "/privacy-policy" },
];
---

<Layout
  title={`${title} | IDSW 2026`}
  description={`${title} for IDSW 2026 organized by PERKODI in Jakarta.`}
  canonicalPath={currentPath}>
  <section class="hero-gradient text-white pt-28 pb-12 sm:pt-36 sm:pb-16 md:pt-40 md:pb-20">
    <div class="container-site">
      <div class="max-w-3xl">
        <h1 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
          {title}
        </h1>
        <p class="mt-4 text-base text-white/85 sm:text-lg leading-relaxed">
          {subtitle}
        </p>
      </div>
    </div>
  </section>

  <div class="bg-neutral-50/80 border-b border-neutral-200">
    <div class="container-site py-10 md:py-16">
      <!-- Mobile Table of Contents -->
      <div class="mb-8 block lg:hidden">
        <details class="group rounded-xl border border-neutral-200 bg-white p-4 shadow-xs transition">
          <summary class="flex cursor-pointer items-center justify-between font-semibold text-neutral-900 list-none">
            <span class="flex items-center gap-2 text-sm">
              <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
              </svg>
              Table of Contents ({toc.length} sections)
            </span>
            <svg
              class="h-4 w-4 text-neutral-500 transition-transform group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <ul class="mt-4 space-y-2 border-t border-neutral-100 pt-3 text-sm text-neutral-600">
            {
              toc.map((item, index) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block rounded-md px-2 py-1.5 transition-colors hover:bg-neutral-100 hover:text-neutral-900">
                    <span class="mr-1.5 text-xs text-neutral-400">{index + 1}.</span>
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </div>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <!-- Main Document Body -->
        <div class="min-w-0 lg:col-span-8">
          <article class="space-y-8 rounded-2xl border border-neutral-200/90 bg-white p-6 sm:p-10 shadow-xs">
            <slot />
          </article>
        </div>

        <!-- Sticky Sidebar -->
        <aside class="hidden lg:col-span-4 lg:block">
          <div class="sticky top-24 space-y-6">
            <!-- Table of Contents Card -->
            <div class="rounded-2xl border border-neutral-200/90 bg-white p-6 shadow-xs">
              <div
                class="flex items-center gap-2 border-b border-neutral-100 pb-3 text-sm font-semibold uppercase tracking-wider text-neutral-900">
                <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"
                  ></path>
                </svg>
                Table of Contents
              </div>
              <nav class="mt-4 max-h-[calc(100vh-280px)] overflow-y-auto pr-2">
                <ol class="space-y-1.5 text-xs sm:text-sm text-neutral-600">
                  {
                    toc.map((item, index) => (
                      <li>
                        <a
                          href={`#${item.id}`}
                          class="group flex items-start gap-2 rounded-lg px-2.5 py-1.5 transition-colors hover:bg-neutral-100 hover:text-neutral-900">
                          <span class="shrink-0 text-neutral-400 group-hover:text-primary font-mono text-xs pt-0.5">
                            {(index + 1).toString().padStart(2, "0")}
                          </span>
                          <span class="leading-snug">{item.title}</span>
                        </a>
                      </li>
                    ))
                  }
                </ol>
              </nav>
            </div>

            <!-- Need Help / Contact Card -->
            <div class="rounded-2xl border border-blue-100 bg-blue-50/70 p-5 shadow-xs">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-blue-900">
                Have questions or need to report?
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-blue-800">
                For Code of Conduct incidents, safety concerns, or legal questions, reach the PERKODI organizing
                committee directly.
              </p>
              <a
                href="mailto:idsw@perkodi.org"
                class="mt-3 inline-flex items-center gap-2 rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-white transition-opacity hover:opacity-90">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                idsw@perkodi.org
              </a>
            </div>

            <!-- Related Legal Documents -->
            <div class="rounded-2xl border border-neutral-200/90 bg-white p-5 shadow-xs">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-500">Related Legal Documents</h3>
              <ul class="mt-3 space-y-1.5 text-xs sm:text-sm">
                {
                  legalLinks.map((link) => {
                    const isCurrent = link.href === currentPath;
                    return (
                      <li>
                        <a
                          href={link.href}
                          class:list={[
                            "flex items-center justify-between rounded-lg px-2.5 py-2 transition-colors",
                            isCurrent
                              ? "bg-primary/10 font-semibold text-primary"
                              : "text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900",
                          ]}>
                          <span>{link.name}</span>
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
