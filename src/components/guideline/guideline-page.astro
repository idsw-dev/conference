---
import Layout from "../../layout.astro";
import { siteConfig } from "../../config/site";
import { withBasePath } from "../../lib/paths";
import Footer from "../sections/footer.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  canonicalPath: string;
}

const { title, subtitle, description, canonicalPath } = Astro.props;

const links = [{ name: "All guidelines", href: "/guideline" }, ...siteConfig.guidelines];
---

<Layout title={`${title} | IDSW 2026`} description={description} canonicalPath={canonicalPath}>
  <section class="hero-gradient pt-28 pb-12 text-white sm:pt-36 sm:pb-16 md:pt-40 md:pb-20">
    <div class="container-site">
      <div class="max-w-3xl">
        <h1 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">{title}</h1>
        <p class="mt-4 text-base leading-relaxed text-white/85 sm:text-lg">{subtitle}</p>
      </div>
    </div>
  </section>

  <div class="border-b border-neutral-200 bg-neutral-50/80">
    <div class="container-site py-12 md:py-16">
      <nav aria-label="Guidelines" class="mb-10 flex flex-wrap gap-2">
        {links.map((link) => (
          <a
            href={withBasePath(link.href)}
            aria-current={link.href === canonicalPath ? "page" : undefined}
            class="rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-100 aria-[current=page]:border-primary aria-[current=page]:bg-primary aria-[current=page]:text-white">
            {link.name}
          </a>
        ))}
      </nav>
      <div class="space-y-16">
        <slot />
      </div>
    </div>
  </div>

  <Footer />
</Layout>
